# Copy to .env and fill in. Never commit .env.
# anthropic (default, Claude) or openai (any OpenAI-compatible endpoint: OpenAI, OpenRouter, LiteLLM, Ollama, vLLM)
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Leave empty for the provider's default URL. Examples for LLM_PROVIDER=openai:
#   Groq        https://api.groq.com/openai/v1
#   NeuralDeep  https://api.neuraldeep.ru/v1
#   Ollama      http://localhost:11434/v1
LLM_BASE_URL=
# Model that runs the skill, and a different model that grades it. Defaults exist only for Claude.
MODEL_SKILL=
MODEL_JUDGE=
# Folder with your skills: <SKILLS_DIR>/<skill>/SKILL.md (e.g. ~/.claude/skills)
SKILLS_DIR=
# Folder with your eval cases (default ./evals) and, optionally, where to keep the history
EVALS_CASES=
EVALS_HISTORY=
# For --mode command: any CLI that reads the request on stdin and prints the answer. {skill} and {skill_file} are filled in.
SKILL_COMMAND=
